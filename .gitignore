# 构建产物（体积大且可随时重建，不入库）
build/
dist/
.build/
*.manifest

# Python 缓存
__pycache__/
*.py[cod]

# 运行时数据（程序会自动生成，属于用户本机状态而非源码）
apps_cache.json
scrcpy_launch.log
*.log

# 应用图标库：图标版权归各 App 所有者，不属于本项目授权范围
# （详见 THIRD-PARTY-NOTICES.md）。本地保留用于打包，不入库。
icons/

# 打包中间产物。快投.spec 是从命令行跑 PyInstaller 时按 --name 自动生成的副本，
# 唯一该维护的是 KuaitouBuild.spec，这份副本别提交进来。
KuaitouBuild.spec.bak
快投.spec

# scrcpy 源码：只当参考用（本项目不改它），1.7 MB / 371 个文件入库只会让
# diff 和克隆都很吵，需要时本地放一份即可
scrcpy-4.1/

# 编辑器 / 系统
.vscode/
.idea/
.trae/
Thumbs.db
desktop.ini